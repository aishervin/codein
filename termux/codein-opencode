#!/data/data/com.termux/files/usr/bin/bash
# Start/stop/status the local OpenCode API for Codein. No browser UI is opened.
set -euo pipefail
ROOT="$HOME/.codein"
STATE="$ROOT/opencode"
LOG="$ROOT/logs/opencode.log"
PIDFILE="$STATE/server.pid"
# Match the local OpenCode endpoint requested by the Android app.
PORT="${OPENCODE_PORT:-4096}"
HOST="127.0.0.1"
mkdir -p "$STATE" "$ROOT/logs"
chmod 700 "$STATE"

alive() {
  [ -f "$PIDFILE" ] || return 1
  local pid
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}
probe() {
  curl --silent --show-error --fail --max-time 2 "http://$HOST:$PORT/global/health" 2>/dev/null ||
  curl --silent --show-error --fail --max-time 2 "http://$HOST:$PORT/" 2>/dev/null
}
case "${1:-start}" in
  status)
    if probe >/dev/null 2>&1; then
      printf '{"ok":true,"running":true,"host":"%s","port":%s}\n' "$HOST" "$PORT"
    else
      printf '{"ok":true,"running":false,"host":"%s","port":%s}\n' "$HOST" "$PORT"
    fi
    ;;
  stop)
    if alive; then kill "$(cat "$PIDFILE")" 2>/dev/null || true; fi
    rm -f "$PIDFILE"
    printf '{"ok":true,"running":false}\n'
    ;;
  start|restart)
    if ! command -v opencode >/dev/null 2>&1; then
      echo "[Codein] OpenCode is not installed. Installing the Termux-compatible build..."
      curl --retry 3 --retry-delay 1 --fail --silent --show-error \
        https://raw.githubusercontent.com/bd-loser/opencode-bionic/main/install.sh | bash
    fi
    if ! command -v opencode >/dev/null 2>&1; then
      echo "[Codein] OpenCode installation did not provide an 'opencode' executable." >&2
      exit 127
    fi
    if probe >/dev/null 2>&1; then
      echo "[Codein] OpenCode API already responds on $HOST:$PORT"
      exit 0
    fi
    if alive; then kill "$(cat "$PIDFILE")" 2>/dev/null || true; sleep 1; fi
    rm -f "$PIDFILE"
    nohup opencode serve --hostname "$HOST" --port "$PORT" >>"$LOG" 2>&1 &
    echo "$!" > "$PIDFILE"
    chmod 600 "$PIDFILE"
    for _ in $(seq 1 30); do
      if probe >/dev/null 2>&1; then
        echo "[Codein] OpenCode API ready at http://$HOST:$PORT"
        exit 0
      fi
      sleep 1
    done
    echo "[Codein] OpenCode did not become ready. Recent log:" >&2
    tail -n 60 "$LOG" >&2 || true
    exit 1
    ;;
  *)
    echo "Usage: codein-opencode {start|stop|status|restart}" >&2
    exit 2
    ;;
esac
