{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codein",
  "main": "worker/src/index.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "BOOTSTRAP_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 3600 }
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 90, "period": 60 }
    }
  ]
}
